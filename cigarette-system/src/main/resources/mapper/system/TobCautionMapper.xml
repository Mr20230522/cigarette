<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TobCautionMapper">
    
    <resultMap type="TobCaution" id="TobCautionResult">
        <result property="cautionId"    column="caution_id"    />
        <result property="detectionId"    column="detection_id"    />
        <result property="behaviorId"    column="behavior_id"    />
        <result property="warningEffect"    column="warning_effect"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="districtId" column="district_id"/>
    </resultMap>

    <sql id="selectTobCautionVo">
        select caution_id, detection_id, behavior_id, warning_effect, status, del_flag, remark, create_time, update_time,district_id from tob_caution
    </sql>

    <select id="selectTobCautionList" parameterType="TobCaution" resultMap="TobCautionResult">
        <include refid="selectTobCautionVo"/>
        <where>  
            <if test="detectionId != null "> and detection_id = #{detectionId}</if>
            <if test="behaviorId != null "> and behavior_id = #{behaviorId}</if>
            <if test="warningEffect != null  and warningEffect != ''"> and warning_effect = #{warningEffect}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="detectionId != null "> and detection_id = #{detectionId}</if>
            <if test="districtId != null "> and district_id = #{districtId}</if>
        </where>
    </select>
    
    <select id="selectTobCautionByCautionId" parameterType="Long" resultMap="TobCautionResult">
        <include refid="selectTobCautionVo"/>
        where caution_id = #{cautionId}
    </select>

    <insert id="insertTobCaution" parameterType="TobCaution" useGeneratedKeys="true" keyProperty="cautionId">
        insert into tob_caution
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="detectionId != null">detection_id,</if>
            <if test="behaviorId != null">behavior_id,</if>
            <if test="warningEffect != null and warningEffect != ''">warning_effect,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="districtId != null "> district_id</if>
            del_flag,
            <if test="remark != null">remark,</if>
            create_time,
            update_time
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="detectionId != null">#{detectionId},</if>
            <if test="behaviorId != null">#{behaviorId},</if>
            <if test="warningEffect != null and warningEffect != ''">#{warningEffect},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="districtId != null ">#{districtId}</if>
            0,
            <if test="remark != null">#{remark},</if>
            sysdate(),
            sysdate(),
         </trim>
    </insert>

    <update id="updateTobCaution" parameterType="TobCaution">
        update tob_caution
        <trim prefix="SET" suffixOverrides=",">
            <if test="detectionId != null">detection_id = #{detectionId},</if>
            <if test="behaviorId != null">behavior_id = #{behaviorId},</if>
            <if test="warningEffect != null and warningEffect != ''">warning_effect = #{warningEffect},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="districtId != null "> district_id = #{districtId}</if>
            update_time = sysdate()
        </trim>
        where caution_id = #{cautionId}
    </update>

    <delete id="deleteTobCautionByCautionId" parameterType="Long">
        update tob_caution set del_flag = '1' where caution_id = #{cautionId}
    </delete>

    <delete id="deleteTobCautionByCautionIds" parameterType="String">
        delete from tob_caution where caution_id in 
        <foreach item="cautionId" collection="array" open="(" separator="," close=")">
            #{cautionId}
        </foreach>
    </delete>
</mapper>