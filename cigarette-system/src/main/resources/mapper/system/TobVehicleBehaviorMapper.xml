<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TobVehicleBehaviorMapper">
    
    <resultMap type="TobVehicleBehavior" id="TobVehicleBehaviorResult">
        <result property="behaviorId"    column="behavior_id"    />
        <result property="carId"    column="car_id"    />
        <result property="carTypeId"    column="car_type_id"    />
        <result property="carColor"    column="car_color"    />
        <result property="degreeSuspicion"    column="degree_suspicion"    />
        <result property="driverId"    column="driver_id"    />
        <result property="drivingDirection"    column="driving_direction"    />
        <result property="illegalStatus"    column="illegal_status"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="accompliceId"    column="accomplice_id"    />
        <result property="detectionId" column="detection_id"/>
        <result property="districtId" column="district_id"/>
    </resultMap>

    <resultMap type="TobVehicleBehaviorVo" id="TobVehicleBehaviorVoResult">
        <result property="behaviorId"    column="behavior_id"    />
        <result property="carId"    column="car_id"    />
        <result property="carTypeId"    column="car_type_id"    />
        <result property="carColor"    column="car_color"    />
        <result property="degreeSuspicion"    column="degree_suspicion"    />
        <result property="driverId"    column="driver_id"    />
        <result property="drivingDirection"    column="driving_direction"    />
        <result property="illegalStatus"    column="illegal_status"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="driverName"    column="name"    />
        <result property="licensePlate"    column="license_plate"    />
        <result property="accompliceId"    column="accomplice_id"    />
        <result property="detectionId" column="detection_id"/>
        <result property="districtId" column="district_id"/>
    </resultMap>

    <sql id="selectTobVehicleBehaviorVo">
        select behavior_id, car_id, car_type_id, car_color, degree_suspicion, driver_id, driving_direction, illegal_status, status, del_flag, remark, create_time, update_time, accomplice_id, detection_id,district_id from tob_vehicle_behavior
    </sql>

    <select id="selectTobVehicleBehaviorList" parameterType="TobVehicleBehavior" resultMap="TobVehicleBehaviorResult">
        <include refid="selectTobVehicleBehaviorVo"/>
        <where>  
            <if test="carId != null "> and car_id = #{carId}</if>
            <if test="carTypeId != null "> and car_type_id = #{carTypeId}</if>
            <if test="carColor != null  and carColor != ''"> and car_color = #{carColor}</if>
            <if test="degreeSuspicion != null "> and degree_suspicion = #{degreeSuspicion}</if>
            <if test="driverId != null "> and driver_id = #{driverId}</if>
            <if test="drivingDirection != null  and drivingDirection != ''"> and driving_direction = #{drivingDirection}</if>
            <if test="illegalStatus != null  and illegalStatus != ''"> and illegal_status = #{illegalStatus}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="accompliceId != null  and accompliceId != ''"> and accomplice_id = #{accompliceId}</if>
            <if test="detectionId != null "> and detection_id = #{detectionId}</if>
            <if test="districtId != null "> and district_id = #{districtId}</if>
            and del_flag = '0'
        </where>
    </select>

    <!--
        选择TobVehicleBehavior表中的记录
    -->
    <select id="selectTobVehicleBehaviorVoList" parameterType="TobVehicleBehaviorVo" resultMap="TobVehicleBehaviorVoResult">

        SELECT a.*,b.license_plate,c.name
        FROM tob_vehicle_behavior AS a
                 INNER JOIN tob_vehicle AS b ON a.car_id = b.car_id
                 LEFT JOIN tob_person AS c ON a.driver_id = c.suspect_id
        <where>
            <if test="carId != null "> and a.car_id = #{carId}</if>
            <if test="carTypeId != null "> and a.car_type_id = #{carTypeId}</if>
            <if test="carColor != null  and carColor != ''"> and a.car_color = #{carColor}</if>
            <if test="degreeSuspicion != null "> and a.degree_suspicion = #{degreeSuspicion}</if>
            <if test="driverId != null "> and a.driver_id = #{driverId}</if>
            <if test="drivingDirection != null  and drivingDirection != ''"> and a.driving_direction = #{drivingDirection}</if>
            <if test="illegalStatus != null  and illegalStatus != ''"> and a.illegal_status = #{illegalStatus}</if>
            <if test="status != null  and status != ''"> and a.status = #{status}</if>
            <if test="accompliceId != null  and accompliceId != ''"> and a.accomplice_id = #{accompliceId}</if>
             <if test="detectionId != null "> and a.detection_id = #{detectionId}</if>
              <if test="districtId != null "> and a.district_id = #{districtId}</if>
        </where>

    </select>


    <select id="selectTobVehicleBehaviorByBehaviorId" parameterType="Long" resultMap="TobVehicleBehaviorResult">
        <include refid="selectTobVehicleBehaviorVo"/>
        where behavior_id = #{behaviorId}
    </select>

    <insert id="insertTobVehicleBehavior" parameterType="TobVehicleBehavior" useGeneratedKeys="true" keyProperty="behaviorId">
        insert into tob_vehicle_behavior
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="carId != null">car_id,</if>
            <if test="carTypeId != null">car_type_id,</if>
            <if test="carColor != null">car_color,</if>
            <if test="degreeSuspicion != null">degree_suspicion,</if>
            <if test="driverId != null">driver_id,</if>
            <if test="drivingDirection != null and drivingDirection != ''">driving_direction,</if>
            <if test="illegalStatus != null and illegalStatus != ''">illegal_status,</if>
            <if test="status != null and status != ''">status,</if>
            del_flag,
            <if test="remark != null">remark,</if>
            create_time,
            update_time,
            <if test="accompliceId != null">accomplice_id,</if>
            <if test="detectionId != null">detection_id,</if>
            <if test="districtId != null">district_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="carId != null">#{carId},</if>
            <if test="carTypeId != null">#{carTypeId},</if>
            <if test="carColor != null">#{carColor},</if>
            <if test="degreeSuspicion != null">#{degreeSuspicion},</if>
            <if test="driverId != null">#{driverId},</if>
            <if test="drivingDirection != null and drivingDirection != ''">#{drivingDirection},</if>
            <if test="illegalStatus != null and illegalStatus != ''">#{illegalStatus},</if>
            <if test="status != null and status != ''">#{status},</if>
            0,
            <if test="remark != null">#{remark},</if>
            sysdate(),
            sysdate(),
            <if test="accompliceId != null">#{accompliceId},</if>
            <if test="detectionId != null">#{detectionId},</if>
            <if test="districtId != null">#{districtId},</if>
         </trim>
    </insert>

    <update id="updateTobVehicleBehavior" parameterType="TobVehicleBehavior">
        update tob_vehicle_behavior
        <trim prefix="SET" suffixOverrides=",">
            <if test="carId != null">car_id = #{carId},</if>
            <if test="carTypeId != null">car_type_id = #{carTypeId},</if>
            <if test="carColor != null">car_color = #{carColor},</if>
            <if test="degreeSuspicion != null">degree_suspicion = #{degreeSuspicion},</if>
            <if test="driverId != null">driver_id = #{driverId},</if>
            <if test="drivingDirection != null and drivingDirection != ''">driving_direction = #{drivingDirection},</if>
            <if test="illegalStatus != null and illegalStatus != ''">illegal_status = #{illegalStatus},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate(),
            <if test="accompliceId != null">accomplice_id = #{accompliceId},</if>
            <if test="detectionId != null">detection_id = #{detectionId},</if>
            <if test="districtId != null">district_id = #{districtId},</if>
        </trim>
        where behavior_id = #{behaviorId}
    </update>

    <delete id="deleteTobVehicleBehaviorByBehaviorId" parameterType="Long">
        update tob_vehicle_behavior set del_flag = '1' where behavior_id = #{behaviorId}
    </delete>

    <delete id="deleteTobVehicleBehaviorByBehaviorIds" parameterType="String">
        update tob_vehicle_behavior set del_flag = '1' where behavior_id in
        <foreach item="behaviorId" collection="array" open="(" separator="," close=")">
            #{behaviorId}
        </foreach>
    </delete>
</mapper>