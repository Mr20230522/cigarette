<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TobCarTypeMapper">
    
    <resultMap type="TobCarType" id="TobCarTypeResult">
        <result property="carTypeId"    column="car_type_id"    />
        <result property="carTypeName"    column="car_type_name"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectTobCarTypeVo">
        select car_type_id, car_type_name, status, del_flag, remark, create_time, update_time from tob_car_type
    </sql>

    <select id="selectTobCarTypeList" parameterType="TobCarType" resultMap="TobCarTypeResult">
        <include refid="selectTobCarTypeVo"/>
        <where>  
            <if test="carTypeName != null  and carTypeName != ''"> and car_type_name like concat('%', #{carTypeName}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectTobCarTypeByCarTypeId" parameterType="Long" resultMap="TobCarTypeResult">
        <include refid="selectTobCarTypeVo"/>
        where car_type_id = #{carTypeId}
    </select>

    <insert id="insertTobCarType" parameterType="TobCarType" useGeneratedKeys="true" keyProperty="carTypeId">
        insert into tob_car_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="carTypeName != null and carTypeName != ''">car_type_name,</if>
            <if test="status != null and status != ''">status,</if>
            del_flag,
            <if test="remark != null">remark,</if>
            create_time,
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="carTypeName != null and carTypeName != ''">#{carTypeName},</if>
            <if test="status != null and status != ''">#{status},</if>
            0,
            <if test="remark != null">#{remark},</if>
            sysdate()
         </trim>
    </insert>

    <update id="updateTobCarType" parameterType="TobCarType">
        update tob_car_type
        <trim prefix="SET" suffixOverrides=",">
            <if test="carTypeName != null and carTypeName != ''">car_type_name = #{carTypeName},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            update_time = sysdate()
        </trim>
        where car_type_id = #{carTypeId}
    </update>

    <delete id="deleteTobCarTypeByCarTypeId" parameterType="Long">
        update tob_car_type set del_flag = '1' where carType_id = #{carTypeId}
    </delete>

    <delete id="deleteTobCarTypeByCarTypeIds" parameterType="String">
        delete from tob_car_type where car_type_id in 
        <foreach item="carTypeId" collection="array" open="(" separator="," close=")">
            #{carTypeId}
        </foreach>
    </delete>
</mapper>