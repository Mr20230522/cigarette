<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TobPersonMapper">
    
    <resultMap type="TobPerson" id="TobPersonResult">
        <result property="suspectId"    column="suspect_id"    />
        <result property="identityCard"    column="identity_card"    />
        <result property="faceFeature"    column="face_feature"    />
        <result property="phone"    column="phone"    />
        <result property="suspectLicenseNumber"    column="suspect_license_number"    />
        <result property="name"    column="name"    />
        <result property="age"    column="age"    />
        <result property="gender"    column="gender"    />
        <result property="address"    column="address"    />
        <result property="occurrenceNumber"    column="occurrence_number"    />
        <result property="illegalStatus"    column="illegal_status"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="casesInvolved"    column="cases_Involved"    />
    </resultMap>

    <sql id="selectTobPersonVo">
        select suspect_id, identity_card, face_feature, phone, suspect_license_number, name, age, gender, address, occurrence_number, illegal_status, status, del_flag, remark, create_time, update_time, cases_Involved from tob_person
    </sql>

    <select id="selectTobPersonList" parameterType="TobPerson" resultMap="TobPersonResult">
        <include refid="selectTobPersonVo"/>
        <where>  
            <if test="identityCard != null "> and identity_card = #{identityCard}</if>
            <if test="faceFeature != null  and faceFeature != ''"> and face_feature = #{faceFeature}</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="suspectLicenseNumber != null  and suspectLicenseNumber != ''"> and suspect_license_number = #{suspectLicenseNumber}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="age != null "> and age = #{age}</if>
            <if test="gender != null  and gender != ''"> and gender = #{gender}</if>
            <if test="address != null  and address != ''"> and address = #{address}</if>
            <if test="occurrenceNumber != null "> and occurrence_number = #{occurrenceNumber}</if>
            <if test="illegalStatus != null  and illegalStatus != ''"> and illegal_status = #{illegalStatus}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="casesInvolved != null "> and cases_Involved = #{casesInvolved}</if>
        </where>
    </select>
    
    <select id="selectTobPersonBySuspectId" parameterType="Long" resultMap="TobPersonResult">
        <include refid="selectTobPersonVo"/>
        where suspect_id = #{suspectId}
    </select>

    <insert id="insertTobPerson" parameterType="TobPerson" useGeneratedKeys="true" keyProperty="suspectId">
        insert into tob_person
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="identityCard != null">identity_card,</if>
            <if test="faceFeature != null">face_feature,</if>
            <if test="phone != null">phone,</if>
            <if test="suspectLicenseNumber != null">suspect_license_number,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="age != null">age,</if>
            <if test="gender != null">gender,</if>
            <if test="address != null">address,</if>
            <if test="occurrenceNumber != null">occurrence_number,</if>
            <if test="illegalStatus != null">illegal_status,</if>
            <if test="status != null and status != ''">status,</if>
            del_flag,
            <if test="remark != null">remark,</if>
            create_time,
            update_time,
            <if test="casesInvolved != null">cases_Involved,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="identityCard != null">#{identityCard},</if>
            <if test="faceFeature != null">#{faceFeature},</if>
            <if test="phone != null">#{phone},</if>
            <if test="suspectLicenseNumber != null">#{suspectLicenseNumber},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="age != null">#{age},</if>
            <if test="gender != null">#{gender},</if>
            <if test="address != null">#{address},</if>
            <if test="occurrenceNumber != null">#{occurrenceNumber},</if>
            <if test="illegalStatus != null">#{illegalStatus},</if>
            <if test="status != null and status != ''">#{status},</if>
            0,
            <if test="remark != null">#{remark},</if>
            sysdate(),
            sysdate(),
            <if test="casesInvolved != null">#{casesInvolved},</if>
         </trim>
    </insert>

    <update id="updateTobPerson" parameterType="TobPerson">
        update tob_person
        <trim prefix="SET" suffixOverrides=",">
            <if test="identityCard != null">identity_card = #{identityCard},</if>
            <if test="faceFeature != null">face_feature = #{faceFeature},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="suspectLicenseNumber != null">suspect_license_number = #{suspectLicenseNumber},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="age != null">age = #{age},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="address != null">address = #{address},</if>
            <if test="occurrenceNumber != null">occurrence_number = #{occurrenceNumber},</if>
            <if test="illegalStatus != null">illegal_status = #{illegalStatus},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate(),
            <if test="casesInvolved != null">cases_Involved = #{casesInvolved},</if>
        </trim>
        where suspect_id = #{suspectId}
    </update>

    <delete id="deleteTobPersonBySuspectId" parameterType="Long">
        update tob_person set del_flag = '1' where suspect_id = #{suspectId}
    </delete>

    <delete id="deleteTobPersonBySuspectIds" parameterType="String">
        delete from tob_person where suspect_id in 
        <foreach item="suspectId" collection="array" open="(" separator="," close=")">
            #{suspectId}
        </foreach>
    </delete>
</mapper>