        <result property="fileNo" column="FileNo"/>
        <result property="startOffset" column="StartOffset"/>
        <result property="srcJson" column="SrcJson"/>
        <result property="level" column="Level"/>
    </resultMap>
    <select id="selectById" parameterType="Long" resultType="com.ruoyi.system.domain.ToVehicleRealTimMonitoring">
        SELECT *
        FROM trafficdata
        WHERE Id = #{id}
    </select>

    <select id="selectAll" resultType="com.ruoyi.system.domain.ToVehicleRealTimMonitoring">
        SELECT *
        FROM trafficdata
        ORDER BY Id ASC
    </select>

    <select id="selectNext" parameterType="map" resultType="com.ruoyi.system.domain.ToVehicleRealTimMonitoring">
        SELECT *
        FROM trafficdata
        WHERE Id > #{lastId}
        ORDER BY Id ASC
        LIMIT 1
    </select>
    <select id="selectAfterId" resultType="com.ruoyi.system.domain.ToVehicleRealTimMonitoring">
        SELECT * FROM trafficdata
        WHERE id > #{lastId}
        ORDER BY id ASC
        LIMIT #{limit}
    </select>

    <update id="updateLevel">
        UPDATE trafficdata
        SET level = #{level}
        WHERE id = #{id}
    </update>
