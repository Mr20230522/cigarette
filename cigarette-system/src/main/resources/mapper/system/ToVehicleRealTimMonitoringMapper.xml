    <resultMap id="ToVehicleResult" type="com.ruoyi.system.domain.ToVehicleRealTimMonitoring">
        <id property="id" column="Id"/>
        <result property="cameraId" column="CameraId"/>
        <result property="cameraName" column="CameraName"/>
        <result property="laneNo" column="LaneNo"/>
        <result property="direction" column="Direction"/>
        <result property="speed" column="Speed"/>
        <result property="plate" column="Plate"/>
        <result property="plateType" column="PlateType"/>
        <result property="plateColor" column="PlateColor"/>
        <result property="vehicleColor" column="VehicleColor"/>
        <result property="vehicleType" column="VehicleType"/>
        <result property="vehicleLogo" column="VehicleLogo"/>
        <result property="vehicleLogoAll" column="VehicleLogoAll"/>
        <result property="captureTime" column="CaptureTime"/>
        <result property="picUrl" column="PicUrl"/>
