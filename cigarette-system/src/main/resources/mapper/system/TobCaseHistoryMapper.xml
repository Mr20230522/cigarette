<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TobCaseHistoryMapper">

    <!-- 显式 resultMap -->
    <resultMap id="TobCaseHistoryResult" type="com.ruoyi.system.domain.TobCaseHistory">
        <id property="id" column="id"/>
        <result property="hisCarPlate" column="his_car_plate"/>
        <result property="hisCarType" column="his_car_type"/>
        <result property="hisCarBrand" column="his_car_brand"/>
    </resultMap>

    <select id="selectAll" resultMap="TobCaseHistoryResult">
        SELECT id, his_car_plate, his_car_type, his_car_brand
        FROM tob_case_history
    </select>

    <select id="selectByPlate" resultMap="TobCaseHistoryResult">
        SELECT id, his_car_plate, his_car_type, his_car_brand
        FROM tob_case_history
        WHERE his_car_plate = #{plate}
    </select>

</mapper>