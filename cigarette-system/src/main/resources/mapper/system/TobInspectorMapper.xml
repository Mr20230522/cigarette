<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TobInspectorMapper">
    
    <resultMap type="TobInspector" id="TobInspectorResult">
        <result property="inspectorId"    column="inspector_id"    />
        <result property="detectionId"    column="detection_id"    />
        <result property="dutyId"    column="duty_id"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="staffId"    column="staff_id"    />
    </resultMap>

    <sql id="selectTobInspectorVo">
        select inspector_id, detection_id, duty_id, status, del_flag, remark, create_time, update_time, staff_id from tob_inspector
    </sql>

    <select id="selectTobInspectorList" parameterType="TobInspector" resultMap="TobInspectorResult">
        <include refid="selectTobInspectorVo"/>
        <where>  
            <if test="detectionId != null "> and detection_id = #{detectionId}</if>
            <if test="dutyId != null "> and duty_id = #{dutyId}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="staffId != null "> and staff_id = #{staffId}</if>
        </where>
    </select>
    
    <select id="selectTobInspectorByInspectorId" parameterType="Long" resultMap="TobInspectorResult">
        <include refid="selectTobInspectorVo"/>
        where inspector_id = #{inspectorId}
    </select>

    <insert id="insertTobInspector" parameterType="TobInspector" useGeneratedKeys="true" keyProperty="inspectorId">
        insert into tob_inspector
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="detectionId != null">detection_id,</if>
            <if test="dutyId != null">duty_id,</if>
            <if test="status != null and status != ''">status,</if>
            del_flag,
            <if test="remark != null">remark,</if>
            create_time,
            update_time,
            <if test="staffId != null">staff_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="detectionId != null">#{detectionId},</if>
            <if test="dutyId != null">#{dutyId},</if>
            <if test="status != null and status != ''">#{status},</if>
            0,
            <if test="remark != null">#{remark},</if>
            sysdate(),
            sysdate(),
            <if test="staffId != null">#{staffId},</if>
         </trim>
    </insert>

    <update id="updateTobInspector" parameterType="TobInspector">
        update tob_inspector
        <trim prefix="SET" suffixOverrides=",">
            <if test="detectionId != null">detection_id = #{detectionId},</if>
            <if test="dutyId != null">duty_id = #{dutyId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate(),
            <if test="staffId != null">staff_id = #{staffId},</if>
        </trim>
        where inspector_id = #{inspectorId}
    </update>

    <delete id="deleteTobInspectorByInspectorId" parameterType="Long">
        update tob_inspector set del_flag = '1' where inspector_id = #{inspectorId}
    </delete>

    <delete id="deleteTobInspectorByInspectorIds" parameterType="String">
        delete from tob_inspector where inspector_id in 
        <foreach item="inspectorId" collection="array" open="(" separator="," close=")">
            #{inspectorId}
        </foreach>
    </delete>
</mapper>