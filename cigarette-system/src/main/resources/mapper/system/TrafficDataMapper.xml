<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ruoyi.system.mapper.TrafficDataMapper">
    <resultMap type="com.ruoyi.system.domain.TrafficData" id="TrafficDataResult">
        <id column="Id" property="id" />
        <result column="CameraId" property="cameraId" />
        <result column="CameraName" property="cameraName" />
        <result column="LaneNo" property="laneNo" />
        <result column="Direction" property="direction" />
        <result column="Speed" property="speed" />
        <result column="Plate" property="plate" />
        <result column="PlateType" property="plateType" />
        <result column="PlateColor" property="plateColor" />
        <result column="VehicleColor" property="vehicleColor" />
        <result column="VehicleType" property="vehicleType" />
        <result column="VehicleLogo" property="vehicleLogo" />
        <result column="VehicleLogoAll" property="vehicleLogoAll" />
        <result column="CaptureTime" property="captureTime" />
        <result column="PicUrl" property="picUrl" jdbcType="LONGVARCHAR"/>
        <result column="PlateLicense" property="plateLicense" jdbcType="LONGVARCHAR"/>
        <result column="FileNo" property="fileNo" />
        <result column="StartOffset" property="startOffset" />
        <result column="SrcJson" property="srcJson" jdbcType="LONGVARCHAR"/>
        <result column="level" property="level" />
        <result column="CleanupStatus" property="cleanupStatus" />
        <result column="CleanupTime" property="cleanupTime" />
        <result column="CreatedAt" property="createdAt" />
        <result column="Ctrl" property="ctrl" />
        <result column="Drive" property="drive" />
        <result column="Part" property="part" />
        <result column="PicDownloadStatus" property="picDownloadStatus" />
        <result column="PicLen" property="picLen" />
        <result column="PlateDownloadStatus" property="plateDownloadStatus" />
        <result column="UpdatedAt" property="updatedAt" />
        <result column="VideoDownloadStatus" property="videoDownloadStatus" />
        <result column="VideoDownloadTime" property="videoDownloadTime" />
        <result column="VideoFilePath" property="videoFilePath" />
    </resultMap>

    <!-- 修改表名为全小写 -->
    <select id="tenList" parameterType="trafficData" resultMap="TrafficDataResult">
        select * from trafficdata
        <where>
            <if test="level!=null">and level>=#{level}</if>
            <if test="id!=null">and Id>#{id} </if>
        </where>
        ORDER BY CaptureTime DESC
        LIMIT 10
    </select>

    <select id="nextTenList" parameterType="trafficData" resultMap="TrafficDataResult">
        select * from trafficdata
        <where>
            <if test="level!=null">and level>=0</if>
            <if test="id!=null">and Id>#{id} </if>
        </where>
        ORDER BY CaptureTime DESC
        LIMIT 10
    </select>

    <select id="allList" parameterType="trafficData" resultMap="TrafficDataResult">
        select * from trafficdata
        <where>
            <if test="level!=null">and level>=#{level}</if>
        </where>
    </select>

    <select id="overIdList" parameterType="trafficData" resultMap="TrafficDataResult">
        select * from trafficdata
        <where>
            <if test="id!=null">and Id>#{id} </if>
            <if test="level!=null">and level>=#{level}</if>
            <if test="captureTime != null">and CaptureTime >= #{captureTime}</if>
        </where>
    </select>

    <select id="byIdGetVideoPath" parameterType="trafficData" resultMap="TrafficDataResult">
        select * from trafficdata
        <where>
            <if test="id!=null">and Id=#{id,jdbcType=BIGINT} </if>
        </where>
    </select>


    <select id="searchVehicle"
            parameterType="com.ruoyi.system.domain.undefine.SearchOfTheSuspectedVehicle"
            resultMap="TrafficDataResult">
        SELECT *
        FROM trafficdata
        <where>
            <!-- 车牌号模糊 -->
            <if test="plate != null and plate != ''">
                AND Plate LIKE CONCAT('%', #{plate}, '%')
            </if>

            <!-- 嫌疑程度区间 -->
            <if test="suspicionMin != 0">
                AND `level` >= #{suspicionMin}
            </if>
            <if test="suspicionMax != 0">
                AND `level` &lt;= #{suspicionMax}
            </if>

            <!-- 时间区间 -->
            <if test="startDate != null and startDate != ''">
                AND CaptureTime &gt;= STR_TO_DATE(#{startDate}, '%Y-%m-%dT%H:%i:%s')
            </if>
            <if test="endDate != null and endDate != ''">
                AND CaptureTime &lt;= STR_TO_DATE(#{endDate}, '%Y-%m-%dT%H:%i:%s')
            </if>
        </where>          <!-- ←←← 这里原来是 </order> 导致报错 -->
        ORDER BY CaptureTime DESC
    </select>

    <!-- 增量同步专用：双参数 -->
    <select id="fetchNewById" resultMap="TrafficDataResult">
        SELECT * FROM trafficdata
        WHERE id > #{lastId}
        ORDER BY id ASC
            LIMIT #{limit}
    </select>

</mapper>