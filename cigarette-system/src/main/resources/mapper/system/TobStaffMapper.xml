<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TobStaffMapper">
    
    <resultMap type="TobStaff" id="TobStaffResult">
        <result property="staffId"    column="staff_id"    />
        <result property="userId"    column="user_id"    />
        <result property="faceFeature"    column="face_feature"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectTobStaffVo">
        select staff_id, user_id, face_feature, status, del_flag, remark, create_time, update_time from tob_staff
    </sql>

    <select id="selectTobStaffList" parameterType="TobStaff" resultMap="TobStaffResult">
        <include refid="selectTobStaffVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="faceFeature != null  and faceFeature != ''"> and face_feature = #{faceFeature}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectTobStaffByStaffId" parameterType="Long" resultMap="TobStaffResult">
        <include refid="selectTobStaffVo"/>
        where staff_id = #{staffId}
    </select>

    <insert id="insertTobStaff" parameterType="TobStaff" useGeneratedKeys="true" keyProperty="staffId">
        insert into tob_staff
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="faceFeature != null">face_feature,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="remark != null">remark,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="faceFeature != null">#{faceFeature},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateTobStaff" parameterType="TobStaff">
        update tob_staff
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="faceFeature != null">face_feature = #{faceFeature},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where staff_id = #{staffId}
    </update>

    <delete id="deleteTobStaffByStaffId" parameterType="Long">
        delete from tob_staff where staff_id = #{staffId}
    </delete>

    <delete id="deleteTobStaffByStaffIds" parameterType="String">
        delete from tob_staff where staff_id in 
        <foreach item="staffId" collection="array" open="(" separator="," close=")">
            #{staffId}
        </foreach>
    </delete>
</mapper>