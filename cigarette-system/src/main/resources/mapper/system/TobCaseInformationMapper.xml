    <sql id="selectTobCaseInformationVo">
        select case_id, case_code, case_name, case_start_date, case_end_date, case_value, incident_location, behavior_id, case_source, case_type, case_status, main_charge, secondary_charge, main_case_details, entry_date, del_flag, remark, case_user_id, staff_id, degree_of_case,detection_id,district_id from tob_case_information
    </sql>

    <select id="selectTobCaseInformationList" parameterType="TobCaseInformation" resultMap="TobCaseInformationResult">
        <include refid="selectTobCaseInformationVo"/>
        <where>  
            <if test="caseCode != null  and caseCode != ''"> and case_code = #{caseCode}</if>
            <if test="caseName != null  and caseName != ''"> and case_name like concat('%', #{caseName}, '%')</if>
            <if test="caseStartDate != null "> and case_start_date = #{caseStartDate}</if>
            <if test="caseEndDate != null "> and case_end_date = #{caseEndDate}</if>
            <if test="caseValue != null "> and case_value = #{caseValue}</if>
            <if test="incidentLocation != null  and incidentLocation != ''"> and incident_location = #{incidentLocation}</if>
            <if test="behaviorId != null "> and behavior_id = #{behaviorId}</if>
            <if test="caseSource != null  and caseSource != ''"> and case_source = #{caseSource}</if>
            <if test="caseType != null  and caseType != ''"> and case_type = #{caseType}</if>
            <if test="caseStatus != null  and caseStatus != ''"> and case_status = #{caseStatus}</if>
            <if test="mainCharge != null  and mainCharge != ''"> and main_charge = #{mainCharge}</if>
            <if test="secondaryCharge != null  and secondaryCharge != ''"> and secondary_charge = #{secondaryCharge}</if>
            <if test="mainCaseDetails != null  and mainCaseDetails != ''"> and main_case_details = #{mainCaseDetails}</if>
            <if test="entryDate != null "> and entry_date = #{entryDate}</if>
            <if test="caseUserId != null "> and case_user_id = #{caseUserId}</if>
            <if test="StaffId != null "> and staff_id = #{staffId}</if>
            <if test="degreeOfCase != null "> and degree_of_case = #{degreeOfCase}</if>
            <if test="detectionId != null "> and detection_id = #{detectionId}</if>
            <if test="districtId != null "> and district_id = #{districtId}</if>
        </where>
    </select>
    
    <select id="selectTobCaseInformationByCaseId" parameterType="Long" resultMap="TobCaseInformationResult">
        <include refid="selectTobCaseInformationVo"/>
        where case_id = #{caseId}
    </select>

    <select id="selectTobCaseInformationVoList" parameterType="TobCaseInformationVo" resultMap="TobCaseInformationVoResult">
        SELECT
            a.*,
            b.user_name AS case_user_name,
            c.user_name AS staff_name,
            f.`name` AS driver_name,
            g.license_plate
        FROM
            tob_case_information AS a
                INNER JOIN
            sys_user AS b
            ON a.case_user_id = b.user_id
                INNER JOIN
            sys_user AS c
            ON a.staff_id = c.user_id
                INNER JOIN
            tob_vehicle_behavior AS d
            ON a.behavior_id = d.behavior_id
                INNER JOIN
            tob_person AS f
            ON d.driver_id = f.suspect_id
                INNER JOIN
            tob_vehicle AS g
            ON d.car_id = g.car_id

        <where>
            <if test="caseCode != null  and caseCode != ''"> and a.case_code LIKE CONCAT('%', #{caseCode}, '%') </if>
            <if test="caseName != null  and caseName != ''"> and a.case_name like concat('%', #{caseName}, '%')</if>
            <if test="caseValue != null "> and a.case_value = #{caseValue}</if>
            <if test="incidentLocation != null  and incidentLocation != ''"> and a.incident_location LIKE CONCAT('%', #{incidentLocation}, '%')</if>
            <if test="caseSource != null  and caseSource != ''"> and a.case_source = #{caseSource}</if>
            <if test="caseType != null  and caseType != ''"> and a.case_type = #{caseType}</if>
            <if test="caseStatus != null  and caseStatus != ''"> and a.case_status = #{caseStatus}</if>
            <if test="mainCharge != null  and mainCharge != ''"> and a.main_charge LIKE CONCAT('%', #{mainCharge}, '%') </if>
            <if test="secondaryCharge != null  and secondaryCharge != ''"> and a.secondary_charge LIKE CONCAT('%', #{secondaryCharge}, '%') </if>
            <if test="driverName != null "> and f.name LIKE CONCAT('%', #{driverName}, '%')</if>
            <if test="staffName != null "> and c.user_name LIKE CONCAT('%', #{staffName}, '%') </if>
            <if test="degreeOfCase != null "> and a.degree_of_case = #{degreeOfCase}</if>
            <if test="caseUserName != null "> and b.user_name LIKE CONCAT('%', #{caseUserName}, '%') </if>
            <if test="licensePlate != null "> and g.license_plate LIKE CONCAT('%', #{licensePlate}, '%')</if>

            <if test="detectionId != null "> and a.detection_id = #{detectionId}</if>
            <if test="districtId != null "> and a.district_id = #{districtId}</if>
        </where>


    </select>

