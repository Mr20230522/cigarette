<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ToFactorTriggerMapper">

    <!-- 通用字段映射 -->
    <resultMap id="BaseResultMap" type="com.ruoyi.system.domain.ToFactorTrigger">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="factorId" column="factor_id" jdbcType="BIGINT"/>
        <result property="triggerValue" column="trigger_value" jdbcType="VARCHAR"/>
        <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 公共列清单 -->
    <sql id="Base_Column_List">
        id, factor_id, trigger_value, updated_at
    </sql>

    <!-- 根据ID查询 -->
    <select id="selectFactorTriggerById" resultMap="BaseResultMap" parameterType="long">
        SELECT <include refid="Base_Column_List"/>
        FROM factor_trigger
        WHERE id = #{id}
    </select>

    <!-- 列表查询 -->
    <select id="selectFactorTriggerList" resultMap="BaseResultMap" parameterType="com.ruoyi.system.domain.ToFactorTrigger">
        SELECT <include refid="Base_Column_List"/>
        FROM factor_trigger
        <where>
            <if test="factorId != null">
                AND factor_id = #{factorId}
            </if>
            <if test="triggerValue != null and triggerValue.trim() != ''">
                AND trigger_value LIKE CONCAT('%', #{triggerValue}, '%')
            </if>
        </where>
    </select>

    <!-- 插入（动态列） -->
    <insert id="insertFactorTrigger"
            parameterType="com.ruoyi.system.domain.ToFactorTrigger"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO factor_trigger
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="factorId != null">factor_id,</if>
            <if test="triggerValue != null">trigger_value,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="factorId != null">#{factorId},</if>
            <if test="triggerValue != null">#{triggerValue},</if>
        </trim>
    </insert>

    <!-- 更新（动态列） -->
    <update id="updateFactorTrigger" parameterType="com.ruoyi.system.domain.ToFactorTrigger">
        UPDATE factor_trigger
        <set>
            <if test="factorId != null">factor_id = #{factorId},</if>
            <if test="triggerValue != null">trigger_value = #{triggerValue},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除 -->
    <delete id="deleteFactorTriggerById" parameterType="long">
        DELETE FROM factor_trigger WHERE id = #{id}
    </delete>

</mapper>
